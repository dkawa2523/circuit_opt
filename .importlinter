; Contracts describe dependency direction. Public behavior is verified by tests.
[importlinter]
root_package = pcd

[importlinter:contract:cli-entry-point]
name = The CLI and module entry point stay outside library imports
type = protected
protected_modules =
    pcd.cli
    pcd.__main__
allowed_importers = pcd.__main__

[importlinter:contract:dependency-direction]
name = Workflows depend on circuit execution and measurements, then on data and numerical primitives
type = layers
; Modules separated by ':' share a layer. Each layer may use the ones below it.
layers =
    pcd.api : pcd.network : pcd.identification : pcd.study : pcd.study_config : pcd.evaluation : pcd.validation : pcd.metrics : pcd.metric_registry : pcd.search : pcd.search_registry : pcd.continuous_search : pcd.least_squares_search : pcd.reporting : pcd.results : pcd.records : pcd.output : pcd.netlist_viz : pcd.figures
    pcd.sim_core : pcd.simulation_input : pcd.sim_methods : pcd.sim_registry : pcd.solver : pcd.ngspice_io : pcd.netlist : pcd.netlist_import : pcd.netlist_parse : pcd.component_models : pcd.component_profiles : pcd.case : pcd.plan : pcd.problem : pcd.sources : pcd.spice : pcd.authoring : pcd.artifacts : pcd.rf_loads : pcd.registry : pcd.tables : pcd.topology_catalog
    pcd.analysis
    pcd.probes : pcd.simulation
    pcd.core
    pcd.signals | pcd.inputs

[importlinter:contract:execution-does-not-measure]
name = Circuit execution produces observations without measuring them
type = forbidden
source_modules =
    pcd.sim_core
    pcd.simulation_input
    pcd.sim_methods
    pcd.sim_registry
    pcd.solver
    pcd.ngspice_io
    pcd.netlist
forbidden_modules = pcd.analysis
